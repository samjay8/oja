# Copy to .env.local for local dev. Production values go in the host's env settings.

# Claude (the sales agent). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5-5
# OJA_MODEL=


# PayPal SANDBOX app. https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Signs vendor dashboard cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Key for the demo seller inbox
DEMO_VENDOR_KEY=oja-demo-2026
# Public URL (used for PayPal return links). Leave empty locally.
APP_URL=

# Postgres (Neon). Leave empty to use embedded PGlite in .data/
DATABASE_URL=

# Meta channels (WhatsApp, Messenger, Instagram) share one webhook: <APP_URL>/api/channels/meta
# App secret from the Meta app dashboard; verifies X-Hub-Signature-256 on webhooks
META_APP_SECRET=
# Token you enter in Meta's webhook setup (falls back to WHATSAPP_VERIFY_TOKEN)
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0
# Encrypts stored channel access tokens (falls back to SESSION_SECRET)
# TOKEN_ENCRYPTION_KEY=

# WhatsApp env fallback when a shop has no connection saved (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VENDOR_SLUG=ife-textiles

# App-wide cap on AI turns per UTC day (model spend cap). Default 400
# OJA_DAILY_TURN_CAP=400
